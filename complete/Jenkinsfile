pipeline {
    agent any
    stages {
        stage('Build') {
            steps {
                dir('complete'){
                  sh 'chmod +x mvnw'
                  sh './mvnw -B clean compile'
                }

            }
        }
        stage('Test') {
            steps {
                dir('complete') {
                    sh './mvnw -B test'
                }
            }
        }
    }
}